{
  "name": "dealcent",
  "main": "src/index.js",
  "vars": { "ADMIN_PASSWORD": "Korea1992!" },
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dealcent-db",
      // 아래 따옴표 안의 글자를 Cloudflare D1 데이터베이스 ID로 바꾸세요
      "database_id": "e65f2a15-faac-477d-a2b9-1ea2a27cb277"
    }
  ]
}
